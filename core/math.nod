fn abs(x) {
    if x < 0 {
        return 0 - x;
    }
    return x;
}

fn min(a, b) {
    if a < b {
        return a;
    }
    return b;
}

fn max(a, b) {
    if a > b {
        return a;
    }
    return b;
}

fn clamp(val, min_val, max_val) {
    let result = val;
    if result < min_val {
        result = min_val;
    }
    if result > max_val {
        result = max_val;
    }
    return result;
}
