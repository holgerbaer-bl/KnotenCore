// Sprint 165: Visual Finesse (Textures)
//
// Demonstrates the new WGPU texture pipeline, asynchronous texture decoding, 
// thread-safe caching, and UV mapping on a rotating 3D Scene Graph object.

import "core/time.nod";
import "core/math.nod";

let win = registry_create_window(800, 600, "KnotenCore - Texture Rendering Pipeline");

// 1. Asynchronously load the texture from disk into the engine's TEXTURE_CACHE
print("Loading texture from assets/wall.png...");
let wall_tex = registry_load_texture("assets/wall.png");
print("Texture loaded. Handle ID:");
print(wall_tex);

// 2. Setup Camera
registry_set_camera_for_window(win, 60.0, 0.0, 0.0, 5.0);

// 3. Spawn a 3D Cube using the custom texture handle
// registry_spawn_cube(window_id, texture_id, width, height, depth, x, y, z)
let cube_id = registry_spawn_cube(win, wall_tex, 2.0, 2.0, 2.0, 0.0, 0.0, 0.0);

UIWindow("ui", "Texture Demo", UIVBox {
    UILabel("WGPU Texturing & UV Mapping Pipeline");
    UILabel("The cube is mapped with assets/wall.png");
});

let running = true;
let angle = 0.0;
let radius = 5.0;

while (running) {
    // Rotate camera around the textured cube to show all sides
    angle = angle + 0.02;
    let cx = sin(angle) * radius;
    let cz = cos(angle) * radius;
    
    registry_set_camera_for_window(win, 60.0, cx, 2.0, cz);

    sleep(16);
}
