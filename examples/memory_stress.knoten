// Sprint 169: Ironclad Memory — Resource Cleanup Stress Test
//
// This script spawns 50 textured cubes per frame in an infinite loop,
// then immediately destroys old entities using registry_destroy_entity.
// RAM and VRAM must remain stable under system monitoring.
//
// WARNING: Run with --allow-read for texture loading.

import "core/time.nod";

let win = registry_create_window(1024, 768, "KnotenCore - Memory Stress Test");
registry_set_camera_for_window(win, 60.0, 0.0, 4.0, 15.0);

let tex = registry_load_texture("assets/wall.png");

print("Memory stress test started. Monitoring RAM and VRAM...");

// Pre-allocate entity ID storage
let max_entities = 50;
let mut ids = [];
let mut idx = 0;
let mut frame = 0;

while (true) {
    // Spawn batch of entities
    let mut j = 0;
    while (j < 10) {
        let x = math_random(-8.0, 8.0);
        let z = math_random(-8.0, 8.0);
        let id = registry_spawn_cube(win, tex, 0.5, 0.5, 0.5, x, 0.0, z);
        ids = array_push(ids, id);
        j = j + 1;
    }

    // Destroy oldest entities to keep count stable
    while (array_len(ids) > max_entities) {
        let old_id = array_get(ids, idx);
        registry_destroy_entity(win, old_id);
        idx = idx + 1;
    }

    frame = frame + 1;
    if (frame % 100 == 0) {
        print("Frame:");
        print(frame);
        print("Active entities:");
        print(array_len(ids));
    }

    sleep(16);
}
