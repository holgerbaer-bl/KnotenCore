// Sprint 161: The Visual Ping-Test
// Minimal Retained-Mode Scene Graph Verification
// Spawns one cube and one sphere, then animates them with a
// smooth hover using a triangle-wave on the Y axis.
//
// CRITICAL: All coordinates MUST be floats (e.g. 1.0, not 1).
// Passing integers to float FFI args triggers ExecResult::Fault.
// The texture argument accepts 0 (Int) to use the default white texture.


// ── Init Phase ─────────────────────────────────────────────────────
let win = registry_create_window(1024, 768, "KnotenCore - Scene Graph Ping-Test");

// 60-degree FOV camera at (0, 2, 8) looking at origin
registry_set_camera_for_window(win, 60.0, 0.0, 2.0, 8.0);

// Spawn cube (1x1x1) at (-1.5, 0.0, 0.0), default white texture (0)
let cube_id = registry_spawn_cube(win, 0, 1.0, 1.0, 1.0, -1.5, 0.0, 0.0);

// Spawn sphere (r=0.7, 16x16 tessellation) at (1.5, 0.0, 0.0)
let sphere_id = registry_spawn_sphere(win, 0, 0.7, 16, 16, 1.5, 0.0, 0.0);

print("Scene Graph initialized.");
print("Cube entity ID:");
print(cube_id);
print("Sphere entity ID:");
print(sphere_id);

// ── Render Loop ────────────────────────────────────────────────────
// The scene graph is rendered autonomously at 60 FPS by the WGPU event loop.
// This loop only pushes updated transforms at ~60 ticks/sec.
//
// Animation: simple triangle-wave hover on Y axis.
//   Phase range: [0.0, 2.0), amplitude 0.8
//   Cube and sphere are phase-shifted by 1.0 (counter-phase).

let t       = 0.0;
let cube_y  = 0.0;
let sphere_y = 0.0;
let p_sphere = 0.0;

let running = true;
while (running) {
    // Advance and wrap time accumulator
    t = t + 0.025;
    if (t >= 2.0) {
        t = t - 2.0;
    }

    // Cube: phase = t
    if (t < 1.0) {
        cube_y = t * 0.8;
    }
    if (t >= 1.0) {
        cube_y = (2.0 - t) * 0.8;
    }

    // Sphere: phase = t + 1.0 (mod 2.0)
    p_sphere = t + 1.0;
    if (p_sphere >= 2.0) {
        p_sphere = p_sphere - 2.0;
    }
    if (p_sphere < 1.0) {
        sphere_y = p_sphere * 0.8;
    }
    if (p_sphere >= 1.0) {
        sphere_y = (2.0 - p_sphere) * 0.8;
    }

    // Push new positions into the retained Scene Graph
    registry_update_entity_transform(win, cube_id, -1.5, cube_y, 0.0);
    registry_update_entity_transform(win, sphere_id, 1.5, sphere_y, 0.0);

    // Throttle to ~60 ticks/sec
    sleep(16);
}
