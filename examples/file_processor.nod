import "core/fs.nod";
import "core/string.nod";
import "core/array.nod";

// Attempt to read this very file as a test
let file_path = "examples/file_processor.nod";
let content = read_text(file_path);
let lines = split(content, "\n");
let num_lines = length(lines);

let parts = split(content, "core");
let core_count = length(parts) - 1;

print("File Processor Example");
print("----------------------");
print("Target File: examples/file_processor.nod");
print("Occurrences of 'core':");
print(core_count);
print("Contains 'Processor':");
print(contains(content, "Processor"));
