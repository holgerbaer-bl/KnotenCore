print("==================================================");
print("   Sprint 103 - Dictionaries and Property Access  ");
print("==================================================");

let player = {
    name: "Hero",
    hp: 100,
    level: 1
};

print("Original Player Name:");
print(player.name);
print("Original Player HP:");
print(player.hp);

fn take_damage(entity, amount) {
    let current_hp = entity.hp;
    entity.hp = current_hp - amount;
    return entity.hp;
}

print(" ");
print("Taking 35 damage via Custom Function...");

let new_hp = take_damage(player, 35);

print(" ");
print("Returned HP from function:");
print(new_hp);

print("Player HP after function call:");
print(player.hp);

if (player.hp == 65) {
    print("SUCCESS: Dictionary reference mutation works perfectly!");
} else {
    print("FAILURE: Dictionary was not mutated by reference!");
}
