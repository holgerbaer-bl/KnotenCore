// Sprint 163: The Control Room — 2D/3D Synthesis
//
// Proves the full retained-mode pipeline:
//   1. A 3D cube lives in the Scene Graph (autonomous WGPU rendering @ 60 FPS)
//   2. An egui overlay floats above it (autonomous egui rendering @ 60 FPS)
//   3. The VM event loop reads button clicks and text inputs asynchronously
//   4. UI state is applied to the 3D entity via registry_update_entity_transform
//
// Controls:
//   [Move Left]    — shift cube -0.5 on X axis
//   [Move Right]   — shift cube +0.5 on X axis
//   [Move Up]      — shift cube +0.5 on Y axis
//   [Move Down]    — shift cube -0.5 on Y axis
//   [Reset]        — return cube to origin (0, 0, 0)
//   UITextInput    — type a float to set the exact X offset (parsed via registry_parse_float)
//
// CRITICAL: All 3D coordinates are strict floats (.0). The texture argument uses
// Int(0) = default white material (Sprint 161 stabilization).

import "core/time.nod";

// ── 3D Scene Init ─────────────────────────────────────────────────
let win = registry_create_window(900, 600, "KnotenCore — The Control Room");

// Camera: 60° FOV, positioned at (0, 1.5, 7) looking toward origin
registry_set_camera_for_window(win, 60.0, 0.0, 1.5, 7.0);

// Spawn the central cube: 1.5×1.5×1.5, at origin, default white texture
let cube_id = registry_spawn_cube(win, 0, 1.5, 1.5, 1.5, 0.0, 0.0, 0.0);

print("Control Room initialised.");
print("Cube entity ID:");
print(cube_id);

// ── 2D UI Overlay ─────────────────────────────────────────────────
// Send the UI tree once. The WGPU/egui render loop will draw it
// autonomously every frame without any further VM interaction.
//
// UIWindow(id, title, body) sends to the retained ui_tree store.
// UITextInput("x_offset") — seed string is also the text-buffer key.
UIWindow("control_room_ui", "Control Room", UIVBox {
    UILabel("── Position Control ──");
    UIHBox {
        UIButton("Move Left");
        UIButton("Move Right");
    };
    UIHBox {
        UIButton("Move Up");
        UIButton("Move Down");
    };
    UIButton("Reset");
    UILabel("── Manual X Offset ──");
    UITextInput("x_offset");
    UIButton("Apply X");
    UILabel("Use float notation e.g. -2.5");
});

// ── State Variables ───────────────────────────────────────────────
let cube_x   = 0.0;
let cube_y   = 0.0;
let cube_z   = 0.0;
let running  = true;

// ── Control Loop ─────────────────────────────────────────────────
while (running) {
    // Poll button events (each returns true once per click, auto-clears)
    let btn_left  = registry_ui_poll_button("Move Left");
    let btn_right = registry_ui_poll_button("Move Right");
    let btn_up    = registry_ui_poll_button("Move Up");
    let btn_down  = registry_ui_poll_button("Move Down");
    let btn_reset = registry_ui_poll_button("Reset");
    let btn_apply = registry_ui_poll_button("Apply X");

    // Apply directional moves
    if (btn_left) {
        cube_x = cube_x - 0.5;
        print("Cube moved left.");
    }
    if (btn_right) {
        cube_x = cube_x + 0.5;
        print("Cube moved right.");
    }
    if (btn_up) {
        cube_y = cube_y + 0.5;
        print("Cube moved up.");
    }
    if (btn_down) {
        cube_y = cube_y - 0.5;
        print("Cube moved down.");
    }
    if (btn_reset) {
        cube_x = 0.0;
        cube_y = 0.0;
        cube_z = 0.0;
        print("Cube reset to origin.");
    }

    // Apply text-input X override
    if (btn_apply) {
        let text_val = registry_ui_read_text("x_offset");
        let parsed_x = registry_parse_float(text_val);
        cube_x = parsed_x;
        print("Applied manual X offset:");
        print(cube_x);
    }

    // Push the updated position into the retained Scene Graph.
    // The render thread applies this transform on the next frame.
    registry_update_entity_transform(win, cube_id, cube_x, cube_y, cube_z);

    // Throttle VM to ~60 Hz — keeps CPU usage minimal while staying responsive
    sleep(16);
}
