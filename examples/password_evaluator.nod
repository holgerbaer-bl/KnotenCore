let pwd = "MySecurePassword123!"
let score = 100

let dict_raw = read_file("examples/blacklist.txt")
let dict = str_split(dict_raw, "\r\n")

if arr_contains(dict, pwd) {
    score = 0
}

if score > 0 {
    if str_len(pwd) > 8 {
        score = score + 10
    }
    if str_contains(pwd, "numbers") {
        score = score + 20
    }
}

print(score)
