{
  "Block": [
    {
      "Assign": [
        "text",
        { "StringLiteral": "Type something here..." }
      ]
    },
    {
      "UIWindow": [
        "MainMenu",
        { "StringLiteral": "KnotenCore UI Demo" },
        {
          "Block": [
            {
              "UIHBox": [
                {
                  "Assign": [
                    "text",
                    { "UITextInput": { "Identifier": "text" } }
                  ]
                },
                {
                  "UIButton": { "StringLiteral": "Submit" }
                }
              ]
            },
            {
              "UILabel": { "Identifier": "text" }
            }
          ]
        }
      ]
    }
  ]
}
