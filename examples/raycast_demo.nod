# Raycast Demo
# Tests 3D interactivity with Screen-To-World unprojection

registry.registry_create_window(800, 600, "Raycast Demo! (Click or press Space)")
target_win = registry.registry_now()

# Add an AABB block at roughly [0, 0, -2]
sys.add_world_aabb([-0.5, -0.5, -2.5], [0.5, 0.5, -1.5])

# Add another AABB block right next to it: [1.5, 0, -2]
sys.add_world_aabb([1.0, -0.5, -2.5], [2.0, 0.5, -1.5])

running = true

while running == true {
    # Close window check
    if registry.registry_window_update(target_win) == false {
        running = false
    }

    # Clear screen (dark gray)
    registry.registry_fill_color(target_win, 30, 30, 30)
    
    # Check interaction - Mouse Down Left or Space
    interact = registry.registry_is_mouse_down()
    if registry.registry_is_key_pressed("SPACE") {
        interact = true
    }

    color_a = 0xFFFFFF  # White default
    color_b = 0xFFFFFF  # White default

    if interact == true {
        # Perform raycast
        ray = registry.registry_get_mouse_ray(target_win)
        
        origin = [ray[0], ray[1], ray[2]]
        dir = [ray[3], ray[4], ray[5]]
        
        hit_id = registry.registry_raycast_aabb(origin, dir)
        
        if hit_id == 0 {
            color_a = 0x00FF00
            sys.print("Hit Object 0!")
        }
        if hit_id == 1 {
            color_b = 0x00FF00
            sys.print("Hit Object 1!")
        }
    }

    # Draw Cube A
    ui.ui_draw_rect(350, 250, 100, 100, color_a)
    ui.ui_draw_text(350, 230, "Object 0", 0xFFFFFF)

    # Draw Cube B
    ui.ui_draw_rect(500, 250, 100, 100, color_b)
    ui.ui_draw_text(500, 230, "Object 1", 0xFFFFFF)
    
    ui.ui_draw_text(10, 10, "Click blocks or press SPACE to raycast mouse cursor!", 0xFFFFFF)

    ui.ui_present()
    system.sleep(16)
}
