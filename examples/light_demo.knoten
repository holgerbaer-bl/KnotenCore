// Sprint 167: Dynamic Lighting Demo (Die Erleuchtung)
//
// This script combines Sprints 165 (Textures), 166 (Math), and 167 (Lighting).
// A textured cube sits in the center while a bright point light orbits
// around it using trigonometric functions, casting real-time Blinn-Phong
// illumination across its surfaces.

import "core/time.nod";

let win = registry_create_window(800, 600, "KnotenCore - Dynamic Lighting Demo");
registry_set_camera_for_window(win, 60.0, 0.0, 4.0, 10.0);

// Load texture and spawn center cube
let wall_tex = registry_load_texture("assets/wall.png");
let cube_id = registry_spawn_cube(win, wall_tex, 3.0, 3.0, 3.0, 0.0, 0.0, 0.0);

// Spawn a second untextured sphere for visual reference
let sphere_id = registry_spawn_sphere(win, 0, 0.3, 16, 16, 5.0, 0.0, 0.0);

// Spawn the orbiting point light (white, high intensity)
let light_id = registry_spawn_light(win, 5.0, 3.0, 0.0, 12.0);

print("KnotenCore Dynamic Lighting Engine Ready.");
print("Light ID:");
print(light_id);

UIWindow("ui", "Sprint 167: Dynamic Lighting", UIVBox {
    UILabel("Blinn-Phong Shading with orbiting Point Light");
    UILabel("The light circles the textured cube using math_sin / math_cos.");
});

let running = true;
let angle = 0.0;
let radius = 6.0;

while (running) {
    angle = angle + 0.02;
    
    // Calculate light orbit position using native math library
    let lx = math_sin(angle) * radius;
    let lz = math_cos(angle) * radius;
    let ly = math_sin(angle * 0.5) * 3.0 + 2.0;
    
    // Update the orbiting light position
    registry_update_light_position(win, light_id, lx, ly, lz);
    
    // Move the small sphere to track the light source visually
    registry_update_entity_transform(win, sphere_id, lx, ly, lz);

    sleep(16);
}
