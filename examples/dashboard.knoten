import "examples/dashboard_config.nod";

let win = registry_create_window(680, 520, "Sprint 183: Persistence Dashboard");

// ── Phase 0: Attempt to load cached state from disk ─────────
print("=== Sprint 183: Persistence Dashboard ===");
print("Attempting to load cache.json...");

let cached_raw = file_read("examples/cache.json");
let cached = json_parse(cached_raw);
let has_cache = obj_has_key(cached, "slideshow");

let parsed;
let source_label;

if (has_cache) {
    print("Cache hit — restoring from disk.");
    parsed = cached;
    source_label = "(loaded from cache)";
} else {
    print("No cache found — falling back to MOCK_JSON.");
    parsed = json_parse(MOCK_JSON);
    source_label = "(loaded from config)";
}

// ── Phase 1: Deep Object Access ────────────────────────────
let title    = parsed.slideshow.title;
let author   = parsed.slideshow.author;
let views    = parsed.slideshow.stats.views;
let active   = parsed.slideshow.stats.active;
let version  = parsed.meta.version;

print("  slideshow.title:  ");
print(title);
print("  slideshow.author: ");
print(author);
print("  slideshow.stats.views:  ");
print(views);
print("  slideshow.stats.active: ");
print(active);
print("  meta.version:     ");
print(version);

// ── Phase 2: Null-Safe Fallback ────────────────────────────
let missing = parsed.slideshow.nonexistent_field;
print("  missing key (should be Void): ");
print(missing);

// ── Phase 3: JSON Stringify roundtrip ───────────────────────
let re_serialized = json_stringify(parsed);
print("=== JSON Stringify ===");
print(re_serialized);

// ── Phase 4: Persist state to disk ──────────────────────────
print("=== Saving state to cache.json ===");
let save_ok = file_write("examples/cache.json", re_serialized);
print("  file_write result: ");
print(save_ok);

// ── Phase 5: UI Dashboard ───────────────────────────────────
print("=== Rendering Dashboard UI ===");

UIWindow("json_dashboard", "JSON Processing Dashboard", UIVBox {
    UILabel("=== Sprint 183: Persistence ===");
    UILabel("Source: " + source_label);
    UILabel("Title: " + title);
    UILabel("Author: " + author);
    UILabel("Views: " + ToString(views));
    UILabel("Active: " + ToString(active));
    UILabel("Version: " + version);
    UILabel("");
    UILabel("JSON roundtrip: " + re_serialized);
    UILabel("Cache saved: " + ToString(save_ok));
});
