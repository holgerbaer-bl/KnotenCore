{
  "KnotenCore - Registry Window": {
    "prefix": "kc-window",
    "body": [
      "registry.registry_create_window(${1:800}, ${2:600}, \"${3:KnotenCore App}\")",
      "win = registry.registry_now()",
      "",
      "running = true",
      "while running == true {",
      "\tif registry.registry_window_update(win) == false {",
      "\t\trunning = false",
      "\t}",
      "",
      "\tregistry.registry_fill_color(win, ${4:20}, ${5:20}, ${6:30})",
      "",
      "\t$0",
      "",
      "\tui.ui_present()",
      "\tsystem.sleep(16)",
      "}"
    ],
    "description": "Create a WGPU window with a standard game loop"
  },
  "KnotenCore - AABB Raycast": {
    "prefix": "kc-raycast",
    "body": [
      "ray = registry.registry_get_mouse_ray(${1:win})",
      "origin = [ray[0], ray[1], ray[2]]",
      "dir = [ray[3], ray[4], ray[5]]",
      "hit_id = registry.registry_raycast_aabb(origin, dir)",
      "if hit_id == ${2:0} {",
      "\t$0",
      "}"
    ],
    "description": "Perform a 3D AABB raycast from mouse position"
  },
  "KnotenCore - egui UIWindow": {
    "prefix": "kc-uiwindow",
    "body": [
      "UIWindow(\"${1:main}\", \"${2:My Window}\", {",
      "\tUILabel(\"${3:Hello, KnotenCore!}\")",
      "\tif UIButton(\"${4:Click Me}\") {",
      "\t\t$0",
      "\t}",
      "})"
    ],
    "description": "Create an egui UIWindow with a label and button"
  },
