{
  "name": "knotencore",
  "displayName": "KnotenCore Language Support",
  "description": "Syntax highlighting for KnotenCore (.knoten) Neural DSL and (.nod) AST files. The Agent-First Rust Engine language extension.",
  "version": "1.0.0",
  "publisher": "holger-bl",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://knotencore.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/holgerbaer-bl/KnotenCore"
  },
  "bugs": {
    "url": "https://github.com/holgerbaer-bl/KnotenCore/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "knotencore",
    "knoten",
    "nod",
    "rust",
    "dsl",
    "scripting",
    "game engine",
    "ai",
    "agent"
  ],
  "activationEvents": [
    "onLanguage:knoten",
    "onLanguage:nod"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "KnotenCore",
      "properties": {
        "knotencore.lspPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the knoten_lsp binary. If left empty, the extension will search the workspace and PATH."
        }
      }
    },
    "languages": [
      {
        "id": "knoten",
        "aliases": [
          "KnotenCore DSL",
          "Knoten",
          "knoten"
        ],
        "extensions": [
          ".knoten"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nod",
        "aliases": [
          "KnotenCore AST",
          "nod"
        ],
        "extensions": [
          ".nod"
        ],
        "configuration": "./language-configuration-nod.json"
      }
    ],
    "grammars": [
      {
        "language": "knoten",
        "scopeName": "source.knoten",
        "path": "./syntaxes/knoten.tmLanguage.json"
      },
      {
        "language": "nod",
        "scopeName": "source.nod",
        "path": "./syntaxes/nod.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "knoten",
        "path": "./snippets/knoten.code-snippets"
      }
    ],
    "themes": []
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "overrides": {
    "undici": "5.28.4"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.32.0"
  }
}
