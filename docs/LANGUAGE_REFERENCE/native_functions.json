    {
      "name": "array_get",
      "module": "fs",
      "description": "Returns the element at index from an Array. Returns Void if index is out of bounds.",
      "parameters": [
        { "name": "array", "type": "Array", "required": true },
        { "name": "index", "type": "Int",   "required": true }
      ],
      "returns": "Any",
      "permissions": [],
