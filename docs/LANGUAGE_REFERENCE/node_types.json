      "description": "Equality comparison. Returns Bool. [left, right]",
      "type": "object",
      "required": ["Eq"],
      "properties": {
        "Eq": {
          "type": "array",
          "prefixItems": [ { "$ref": "#" }, { "$ref": "#" } ],
          "minItems": 2, "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Less-than comparison. Returns Bool. [left, right]",
      "type": "object",
