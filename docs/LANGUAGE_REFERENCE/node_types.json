      "required": ["Cos"],
      "properties": { "Cos": { "$ref": "#" } },
      "additionalProperties": false
    },
    {
      "description": "Absolute value",
      "type": "object",
      "required": ["Abs"],
      "properties": { "Abs": { "$ref": "#" } },
      "additionalProperties": false
    },
