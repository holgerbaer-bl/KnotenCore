        "BitShiftRight": {
          "type": "array",
          "prefixItems": [ { "$ref": "#" }, { "$ref": "#" } ],
          "minItems": 2, "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    {
      "description": "String concatenation. [left, right]",
      "type": "object",
      "required": ["Concat"],
      "properties": {
        "Concat": {
          "type": "array",
          "prefixItems": [ { "$ref": "#" }, { "$ref": "#" } ],
