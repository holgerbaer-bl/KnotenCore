        }
      },
      "additionalProperties": false
    },
    {
      "description": "Division. Returns Fault on division by zero. [left, right]",
      "type": "object",
      "required": ["Div"],
      "properties": {
        "Div": {
          "type": "array",
          "prefixItems": [ { "$ref": "#" }, { "$ref": "#" } ],
          "minItems": 2, "maxItems": 2
