      "type": "object",
      "required": ["Print"],
      "properties": { "Print": { "$ref": "#" } },
      "additionalProperties": false
    },
    {
      "description": "Addition. [left, right]",
      "type": "object",
      "required": ["Add"],
      "properties": {
        "Add": {
          "type": "array",
          "prefixItems": [ { "$ref": "#" }, { "$ref": "#" } ],
          "minItems": 2, "maxItems": 2
