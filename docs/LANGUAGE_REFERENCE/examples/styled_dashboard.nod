            {
              "FloatLiteral": 0.4
            },
            {
              "FloatLiteral": 1.0
            }
          ]
        }
      ]
    },
    {
      "UIWindow": [
        "dashboard_win",
        {
          "StringLiteral": "Styled Visual Dashboard"
        },
        {
          "Block": [
            {
              "UIHBox": [
                {
                  "UIVBox": [
                    {
                      "UILabel": {
                        "StringLiteral": "=== LEFT PANEL: Text Editor ==="
                      }
                    },
                    {
                      "Assign": [
                        "text",
                        {
                          "UITextInput": {
                            "StringLiteral": "text"
                          }
                        }
                      ]
                    },
                    {
                      "If": [
                        {
                          "UIButton": {
                            "StringLiteral": "Clear Text"
                          }
                        },
                        {
                          "Assign": [
                            "text",
                            {
                              "StringLiteral": ""
                            }
                          ]
                        },
                        null
                      ]
                    }
                  ]
                },
                {
                  "UIVBox": [
                    {
                      "UILabel": {
                        "StringLiteral": "=== RIGHT PANEL: Math & Visualisation ==="
                      }
                    },
                    {
                      "Assign": [
                        "angle",
                        {
                          "Add": [
                            {
                              "Identifier": "angle"
                            },
                            {
                              "FloatLiteral": 0.05
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "Assign": [
                        "sin_val",
                        {
                          "ExternCall": {
                            "module": "math",
                            "function": "math_sin",
                            "args": [
                              {
                                "Identifier": "angle"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "Assign": [
                        "cos_val",
                        {
                          "ExternCall": {
                            "module": "math",
                            "function": "math_cos",
                            "args": [
                              {
                                "Identifier": "angle"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "ExternCall": {
                        "module": "ui",
                        "function": "ui_progress_gauge",
                        "args": [
                          {
                            "StringLiteral": "Sinus Wave"
                          },
                          {
                            "Identifier": "sin_val"
                          },
                          {
                            "FloatLiteral": -1.0
                          },
                          {
                            "FloatLiteral": 1.0
                          }
                        ]
                      }
                    },
                    {
                      "ExternCall": {
                        "module": "ui",
                        "function": "ui_progress_gauge",
                        "args": [
                          {
                            "StringLiteral": "Cosinus Wave"
                          },
                          {
                            "Identifier": "cos_val"
                          },
                          {
                            "FloatLiteral": -1.0
                          },
                          {
                            "FloatLiteral": 1.0
                          }
                        ]
                      }
                    },
                    {
                      "ExternCall": {
                        "module": "ui",
                        "function": "ui_bar_chart",
                        "args": [
                          {
                            "StringLiteral": "Waveform Cache"
                          },
                          {
                            "ArrayCreate": [
