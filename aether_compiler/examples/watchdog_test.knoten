// Sprint 171: The Watchdog — CPU Freeze Protection Test
//
// This script spawns a 3D sphere and then enters an intentional
// infinite loop. The Watchdog timer (50ms) in the Stack-VM must
// detect the timeout and abort the script before the CPU freezes.
//
// Expected behavior:
//   1. A sphere appears in the window
//   2. After ~50ms, the console shows:
//      "[KnotenCore Watchdog] Execution timeout exceeded (50ms)..."
//   3. Script aborts, window stays open, sphere keeps rendering at 60 FPS

let win = registry_create_window(1024, 768, "KnotenCore - Watchdog Test");
registry_set_camera_for_window(win, 60.0, 0.0, 2.0, 8.0);

print("Spawning sphere...");
let tex = 0;
let sphere = registry_spawn_sphere(win, tex, 1.0, 16, 16, 0.0, 1.0, 0.0);
print("Sphere spawned. Entering infinite loop — watchdog should kill in 50ms...");

// Intentional infinite loop — Watchdog must terminate this
while (1 < 2) {
    // Empty body — pure CPU burn
    let _ = 0;
}

// This line should never be reached
print("ERROR: Script survived infinite loop — watchdog is BROKEN!");
