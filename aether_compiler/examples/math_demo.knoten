// Sprint 166: The Math Standard Library (Das Gehirn)
//
// This script proves the Retained-Mode Math FFI bindings.
// It spawns a textured cube and an orbiting sphere whose position
// is calculated using math_sin and math_cos in the VM loop.


let win = registry_create_window(800, 600, "KnotenCore - Math Orbit Demo");
registry_set_camera_for_window(win, 60.0, 0.0, 4.0, 10.0);

// Load texture and spawn center cube
let wall_tex = registry_load_texture("assets/wall.png");
let cube_id = registry_spawn_cube(win, wall_tex, 2.0, 2.0, 2.0, 0.0, 0.0, 0.0);

// Spawn orbiting sphere (no texture)
let sphere_id = registry_spawn_sphere(win, 0, 0.5, 32, 32, 5.0, 0.0, 0.0);

print("KnotenCore Math Engine Ready.");
print("Center Cube ID:");
print(cube_id);
print("Orbiting Sphere ID:");
print(sphere_id);

UIWindow("ui", "Math FFI Demo", UIVBox {
    UILabel("Sprint 166: Mathematical Standard Library");
    UILabel("The sphere orbits the textured cube using math_sin and math_cos.");
});

let running = true;
let angle = 0.0;
let radius = 5.0;

while (running) {
    angle = angle + 0.03;
    
    // Calculate orbit positions using the Math standard library bindings
    let x = math_sin(angle) * radius;
    let z = math_cos(angle) * radius;
    
    // Update sphere position
    registry_update_entity_transform(win, sphere_id, x, 0.0, z);

    sleep(16);
}
